# Google Places API key — used server-side only to resolve URLs, fetch place
# details, and fetch photos. Never exposed to the browser.
GOOGLE_PLACES_API_KEY=

# Vercel API token — used server-side only to create deployments.
VERCEL_API_TOKEN=

# Optional: Vercel team ID. Set if your token belongs to a team rather than a
# personal account.
VERCEL_TEAM_ID=
